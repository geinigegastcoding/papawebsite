# Local development only. Never commit real values.
PAPA_APP_PASSWORD=choose-a-long-private-password
PAPA_AUTH_SECRET=generate-a-random-32-byte-secret
OPENROUTER_API_KEY=replace-with-openrouter-key
# Optional model order overrides. Keep at most three backups.
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,openrouter/free
